# ==============================================================================
# VARIÁVEIS DE AMBIENTE - DESPENSA
# ==============================================================================
# Configure estas variáveis no seu arquivo .env.local (desenvolvimento)
# e no painel da Vercel (Project Settings > Environment Variables).

# URL do projeto Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Chave pública anon do Supabase (Project Settings > API > Project API keys > anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
